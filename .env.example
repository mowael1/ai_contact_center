# ---- Database ----
# Supabase / PostgreSQL (recommended - works from macOS with no ODBC driver).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# SQL Server instead (leave DATABASE_URL empty to use these).
# DB_USER/DB_PASSWORD switch on SQL authentication; without them the driver
# falls back to Windows integrated auth, which does not work off Windows.
DB_SERVER=
DB_NAME=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=
DB_PASSWORD=

# ---- Auth ----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
