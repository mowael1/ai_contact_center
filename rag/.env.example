# Copy to rag/.env and fill in. NEVER commit the real .env.

# ---- Chroma Cloud (the only vector database; no local persistence) ----
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=vf_egypt_kb

# ---- Embeddings ----
# EMBEDDING_PROVIDER: openai | cohere | sentence_transformers | local_lexical | hash
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=96
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- LLM ----
# LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# ---- Retrieval-text policy ----
# enhanced_first | language_aware | raw_only
# NOTE: ~88% of Arabic pages in this corpus have an llm_enhanced_text that was
# translated into English. This only affects the text-fallback path, since
# chunk text normally comes from raw_html. Use language_aware to keep those
# pages in Arabic.
RETRIEVAL_TEXT_POLICY=enhanced_first

# ---- Chunking (tuned against real section-size statistics) ----
CHUNK_TARGET_SIZE=700
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=1400
SEMANTIC_SIMILARITY_THRESHOLD=0.55
CHUNK_OVERLAP=1

# ---- Retrieval ----
TOP_K=5
MAX_CONTEXT_CHARS=8000

# ---- Misc ----
LOG_LEVEL=INFO
