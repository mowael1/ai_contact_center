# Copy to rag/.env and fill in. NEVER commit the real .env.

# ---- Chroma Cloud (the only vector database; no local persistence) ----
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=vf_egypt_kb

# ---- Embeddings ----
# EMBEDDING_PROVIDER: embeddinggemma_hf | embeddinggemma_local | openai
#                   | cohere | sentence_transformers | local_lexical | hash
# google/embeddinggemma-300m is a GATED repo: accept its licence on the model
# page first, then use a read token here.
EMBEDDING_PROVIDER=embeddinggemma_hf
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_BATCH_SIZE=128
# Boundary-detection embeddings are discarded and outnumber stored chunk
# vectors ~3:1. Empty = same provider as EMBEDDING_PROVIDER. Set to
# local_lexical to cut ~77% of hosted-API calls during ingestion.
CHUNKING_EMBEDDING_PROVIDER=
HF_API_TOKEN=
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/hf-inference
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- LLM (generation) ----
# LLM_PROVIDER: gemini | anthropic | openai | echo (offline stub)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_STREAMING=true
# Gemini free tier allows only 20 requests/day PER MODEL. Pacing + 429 retry
# handle the per-minute limit; the daily cap needs a paid tier for a full
# evaluation run. 0 disables client-side pacing.
LLM_REQUESTS_PER_MINUTE=14
LLM_MAX_RETRIES=5

# ---- Judge LLM (context evaluation inside the agentic graph) ----
# Deliberately a different, cheaper model from the generator: the model that
# writes the answer should not grade its own evidence.
# Keeping the judge on a DIFFERENT model also doubles the free-tier daily
# budget, since the quota is per-model.
JUDGE_LLM_PROVIDER=gemini
JUDGE_LLM_MODEL=gemini-2.5-flash-lite

# ---- Agentic retrieval graph (LangGraph) ----
# false -> the linear retrieve -> generate pipeline
AGENTIC_ENABLED=true
MAX_RETRIEVAL_ATTEMPTS=3
CONTEXT_RELEVANCE_THRESHOLD=0.5

# ---- Retrieval-text policy ----
# enhanced_first | language_aware | raw_only
# NOTE: ~88% of Arabic pages in this corpus have an llm_enhanced_text that was
# translated into English. This only affects the text-fallback path, since
# chunk text normally comes from raw_html. Use language_aware to keep those
# pages in Arabic.
RETRIEVAL_TEXT_POLICY=enhanced_first

# ---- Chunking (tuned against real section-size statistics) ----
CHUNK_TARGET_SIZE=700
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=1400
SEMANTIC_SIMILARITY_THRESHOLD=0.55
CHUNK_OVERLAP=1

# ---- Retrieval ----
TOP_K=5
MAX_CONTEXT_CHARS=8000
DEDUPLICATE_RESULTS=true

# ---- Misc ----
LOG_LEVEL=INFO
